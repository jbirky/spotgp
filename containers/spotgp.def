Bootstrap: docker
From: python:3.12-slim

%labels
    Author Jessica Birky
    Description spotgp research computing environment

%post
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir \
        spotgp[jax,hdf5] \
        blackjax \
        dynesty \
        lightkurve \
        streamlit \
        dvc \
        mlflow

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec python "$@"
